  "facts": [
    { "id": "f_party", "text": "The Whitlocks are at the Loon Lake cabin for Grandma June's seventy-fifth birthday.", "about": ["june"], "kind": "event", "fingerprints": [] },
    { "id": "f_lure_gone", "text": "Old Goldie went missing from its locked glass case over the fireplace between the fish fry and the fireworks.", "about": ["june", "great_room"], "kind": "event", "place": "great_room", "fingerprints": [] },
    { "id": "f_sparklers", "text": "At nine o'clock the whole family walked down to the dock for sparklers and Dale's fireworks.", "about": ["dale", "dock"], "kind": "event", "place": "dock", "time": "9:00 pm", "fingerprints": [] },
    { "id": "f_case_unbroken", "text": "Old Goldie's case was opened with a key: the glass is whole and the lock has no scratches.", "about": ["great_room"], "kind": "state", "place": "great_room", "fingerprints": [] },
    { "id": "f_spare_key", "text": "The only spare key to the case is taped inside the lid of June's blue sewing tin in the kitchen.", "about": ["june", "kitchen"], "kind": "state", "place": "kitchen", "fingerprints": [] },
    { "id": "f_june_retaped", "text": "June dusted the case on Saturday morning and taped the spare key back into her sewing tin with fresh tape.", "about": ["june"], "kind": "event", "time": "Saturday morning", "fingerprints": [] },
    { "id": "f_june_found", "text": "Grandma June went up to the cabin at twenty to ten and found the case empty.", "about": ["june"], "kind": "event", "place": "great_room", "time": "9:40 pm", "fingerprints": [] },
    { "id": "f_tess_filmed", "text": "Tess ran back up to the cabin at ten past nine for her phone charger and filmed the great room for her vlog.", "about": ["tess", "great_room"], "kind": "event", "place": "great_room", "time": "9:10 pm", "fingerprints": [] },
    { "id": "f_video_910", "text": "Tess's ten-past-nine video shows Old Goldie still in its case.", "about": ["tess", "great_room"], "kind": "event", "place": "great_room", "time": "9:10 pm", "fingerprints": [] },
    { "id": "f_tess_stream", "text": "Tess livestreamed the fireworks from the end of the dock from a quarter past nine until ten, with forty people watching.", "about": ["tess", "dock"], "kind": "opportunity", "place": "dock", "time": "9:15 pm", "fingerprints": ["livestreamed the fireworks from the end of the dock"], "logic": { "suspectId": "tess", "attr": "opportunity", "holds": false } },
    { "id": "f_lorraine_knits", "text": "Lorraine has been knitting a cranberry-red mohair sweater for June all weekend.", "about": ["lorraine"], "kind": "state", "fingerprints": [] },
    { "id": "f_lorraine_motive", "text": "Lorraine says their father promised Old Goldie to her, and she has brought it up every Christmas since 1979.", "about": ["lorraine", "june"], "kind": "motive", "fingerprints": ["promised old goldie to her", "every christmas since 1979"], "logic": { "suspectId": "lorraine", "attr": "motive", "holds": true } },
    { "id": "f_lorraine_opp", "text": "Lorraine slipped back up to the cabin at twenty past nine and was alone in the great room.", "about": ["lorraine", "great_room"], "kind": "opportunity", "place": "great_room", "time": "9:20 pm", "fingerprints": ["slipped back up to the cabin", "alone in the great room"], "logic": { "suspectId": "lorraine", "attr": "opportunity", "holds": true } },
    { "id": "f_lorraine_means", "text": "Lorraine's fingerprints are on the fresh tape inside June's sewing tin, so she handled the spare key.", "about": ["lorraine", "kitchen"], "kind": "means", "fingerprints": ["fingerprints are on the fresh tape", "she handled the spare key"], "logic": { "suspectId": "lorraine", "attr": "means", "holds": true } },
    { "id": "f_lorraine_took", "text": "Lorraine took Old Goldie and hid it in the sleeve of the sweater she is knitting.", "about": ["lorraine"], "kind": "event", "fingerprints": ["hid it in the sleeve"] },
    { "id": "f_lorraine_asked_tin", "text": "On Saturday morning Lorraine asked Tess whether June still keeps the spare key in her sewing tin.", "about": ["lorraine", "tess"], "kind": "event", "time": "Saturday morning", "fingerprints": ["asked tess whether june still keeps"] },
    { "id": "f_dale_dealership", "text": "Dale's car dealership is behind on its bank loan this summer.", "about": ["dale"], "kind": "motive", "fingerprints": ["behind on its bank loan"], "logic": { "suspectId": "dale", "attr": "motive", "holds": true } },
    { "id": "f_dale_phone", "text": "Tess overheard Dale on the phone saying 'eight thousand, cash, by Monday.'", "about": ["dale", "tess"], "kind": "event", "fingerprints": ["eight thousand cash by monday"] },
    { "id": "f_dale_boathouse", "text": "Dale lit fireworks on the dock until twenty past nine, then spent twenty minutes in the boathouse on the phone with a buyer for his bass boat.", "about": ["dale", "boathouse"], "kind": "opportunity", "place": "boathouse", "time": "9:20 pm", "fingerprints": ["buyer for his bass boat", "twenty minutes in the boathouse"], "logic": { "suspectId": "dale", "attr": "opportunity", "holds": false } },
    { "id": "f_marv_offer", "text": "Marv has offered to buy Old Goldie every summer for forty years, and he offered eight thousand dollars again at the party.", "about": ["marv"], "kind": "motive", "fingerprints": ["offered to buy old goldie every summer"], "logic": { "suspectId": "marv", "attr": "motive", "holds": true } },
    { "id": "f_marv_pontoon", "text": "Marv stayed on his pontoon boat off the end of the dock from nine until ten and never came ashore.", "about": ["marv", "dock"], "kind": "opportunity", "place": "dock", "fingerprints": ["never came ashore"], "logic": { "suspectId": "marv", "attr": "opportunity", "holds": false } },
    { "id": "f_marv_fools_goldie", "text": "Marv carved his own gold lure in 1990 to tease June's late husband, Walt, and he calls it Fool's Goldie.", "about": ["marv"], "kind": "state", "fingerprints": ["calls it fool's goldie"] },
    { "id": "f_marv_light", "text": "From his pontoon, Marv saw a flashlight moving in the cabin's great room at about twenty past nine.", "about": ["marv", "great_room"], "kind": "event", "place": "great_room", "time": "9:20 pm", "fingerprints": ["flashlight moving in the cabin"] }
