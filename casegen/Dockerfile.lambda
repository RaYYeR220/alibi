# Case-generation worker for Lambda (x86_64). Build context: the repository root,
# so the image can carry the canon CLI that the pipeline shells out to.

FROM node:22-bookworm-slim AS canon
WORKDIR /src
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter @alibi/canon && pnpm --filter @alibi/canon bundle

FROM public.ecr.aws/lambda/python:3.12
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
WORKDIR ${LAMBDA_TASK_ROOT}
COPY casegen/pyproject.toml casegen/uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o requirements.txt \
 && uv pip install --system --target ${LAMBDA_TASK_ROOT} -r requirements.txt
COPY casegen/config.json ./
COPY casegen/alibi_casegen ./alibi_casegen
COPY packages/canon/test/fixtures/tiny-case.json ./repo/packages/canon/test/fixtures/tiny-case.json
COPY --from=canon /src/packages/canon/dist/cli.bundle.mjs ./repo/packages/canon/dist/cli.mjs
ENV ALIBI_KEY_SOURCE=identity \
    ALIBI_REPO_ROOT=${LAMBDA_TASK_ROOT}/repo \
    ALIBI_CANON_CLI=${LAMBDA_TASK_ROOT}/repo/packages/canon/dist/cli.mjs
CMD ["alibi_casegen.lambda_handler.handler"]
