{
  "name": "@alibi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/local.ts",
    "bundle": "pnpm --filter @alibi/canon build && pnpm --filter @alibi/apps build && tsx scripts/build-lambda.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@alibi/canon": "workspace:^",
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/client-scheduler": "^3.1153.0",
    "@aws-sdk/client-sfn": "^3.1153.0",
    "@aws-sdk/client-ssm": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/credential-providers": "^3.1153.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
