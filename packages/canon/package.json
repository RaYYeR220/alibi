{
  "name": "@alibi/canon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/export-schema.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "schema": "tsx scripts/export-schema.ts",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.bundle.mjs"
  },
  "dependencies": {
    "fast-check": "^4.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  },
  "bin": {
    "alibi-canon": "./dist/cli.js"
  }
}
