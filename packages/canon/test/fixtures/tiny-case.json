  "anchors": [
    { "id": "a_cold_open", "speakerId": "narrator", "trigger": "cold_open", "text": "Ashby House, half past ten. The birthday candles are out, and Aunt Margaret's sapphire brooch is gone from a locked desk. Three people were in the house. One of them is lying to you." },
    { "id": "a_harold_crack", "speakerId": "harold", "trigger": "crack", "lieId": "l_harold", "text": "Fine. I came in at nine to fetch garden twine, muddy boots and all. But that desk was locked tight when I left. I swear it." },
    { "id": "a_clara_crack", "speakerId": "clara", "trigger": "crack", "lieId": "l_clara", "text": "All right, I slipped into the study at a quarter past nine. I only wanted to look at Mother's portrait. That isn't a crime." },
    { "id": "a_confession", "speakerId": "clara", "trigger": "confession", "text": "I owed more than I could ever pay. Clara took the brooch, all right? I took it. I'm so sorry, Aunt Margaret." },
    { "id": "a_end_correct", "speakerId": "narrator", "trigger": "ending_correct", "text": "The lily scent on the key, the handkerchief under the desk, the debt she could not hide. Clara Vance took the brooch, and Aunt Margaret gets her sapphire back before midnight." },
    { "id": "a_end_partial", "speakerId": "narrator", "trigger": "ending_partial", "text": "You named the right person, but without the evidence in hand, the case would never stand." },
    { "id": "a_end_wrong", "speakerId": "narrator", "trigger": "ending_wrong", "text": "The accusation falls apart under questioning. Somewhere in Ashby House, the real thief breathes a little easier." }
